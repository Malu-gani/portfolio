---
import { claseAccionBoton, iconosAccion, type VarianteAccion } from '../data/boton-accion';

interface Props {
  href: string;
  variante: VarianteAccion;
  tono: 'acento' | 'neutro';
  tamano: 'grande' | 'chica';
  texto: string;
  testid: string;
  target?: '_blank';
  download?: boolean;
}

const { href, variante, tono, tamano, texto, testid, target, download } = Astro.props;

const claseTono =
  tono === 'acento'
    ? 'border-accent text-accent hover:bg-surface'
    : 'border-border text-muted hover:border-accent hover:text-accent';
---
<a href={href} data-testid={testid} target={target}
  rel={target === '_blank' ? 'noopener noreferrer' : undefined}
  download={download}
  class:list={[claseAccionBoton[tamano], claseTono]}>
  <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" set:html={iconosAccion[variante]} />
  <span>{texto}</span>
</a>
