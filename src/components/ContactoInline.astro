---
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

/**
 * Contacto abreviado para el hero. La sección completa sigue al cierre de la
 * home y en `/contacto`: son los dos momentos en que alguien quiere
 * contactarte, apenas llega y cuando terminó de leer.
 *
 * El email es un `mailto:` en el HTML y copia al portapapeles con un script
 * suelto, no con el island de React de la sección Contacto. El `mailto:` solo
 * era un click muerto para quien no tiene cliente de correo configurado —el
 * caso más común en Windows—, y montar un tercer punto de hidratación en el
 * hero, que es lo primero que carga, no se justificaba por un botón de copiar.
 */
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const email = 'maluganijuanmanuel@gmail.com';

const clase =
  'inline-block rounded-md border border-border px-3 py-1.5 text-sm text-muted transition-colors hover:border-accent hover:text-accent';

const externos = [
  { testid: 'hero-github', href: 'https://github.com/Malu-gani', texto: 'GitHub' },
  { testid: 'hero-linkedin', href: 'https://www.linkedin.com/in/maluganijuanmanuel', texto: 'LinkedIn' },
];
---
<ul data-testid="contacto-inline" aria-label={t('contacto.enlaces')} class="mt-6 flex flex-wrap gap-3">
  {externos.map((e) => (
    <li>
      <a href={e.href} data-testid={e.testid} target="_blank" rel="noopener noreferrer" class={clase}>
        {e.texto}
      </a>
    </li>
  ))}
  <li>
    <a href={`mailto:${email}`} data-testid="hero-email"
      data-copiado={t('contacto.copiado')} class={clase}>
      <!-- "Email" queda igual en los dos idiomas, como "Stack" y "Projects". -->
      <span data-etiqueta="Email">Email</span>
    </a>
    <span data-testid="hero-email-aviso" role="status" aria-live="polite" class="sr-only"></span>
  </li>
</ul>

<script>
  // El enlace es y sigue siendo un `mailto:`. Copiar se engancha encima: si no
  // hay JavaScript, o el navegador no expone el portapapeles, el clic hace lo
  // que siempre hizo y nadie se queda sin camino.
  import { engancharCopiar } from '../scripts/copiar';

  const MS_AVISO = 2000;
  let temporizador: ReturnType<typeof setTimeout> | undefined;

  function partes(enlace: HTMLElement) {
    return {
      etiqueta: enlace.querySelector<HTMLElement>('[data-etiqueta]'),
      aviso: enlace.parentElement?.querySelector<HTMLElement>('[data-testid="hero-email-aviso"]'),
    };
  }

  engancharCopiar({
    selectorDisparador: '[data-testid="hero-email"]',
    texto: (enlace) => (enlace as HTMLAnchorElement).href.replace(/^mailto:/, ''),
    alCopiar: (enlace) => {
      const { etiqueta, aviso } = partes(enlace);
      if (!etiqueta || !aviso) return;
      const copiado = enlace.dataset.copiado ?? '';
      etiqueta.textContent = copiado;
      aviso.textContent = copiado;

      // El texto original se restaura desde el atributo y no desde lo que hay
      // en pantalla: un segundo clic dentro de los dos segundos leería
      // "Copiado" y lo dejaría ahí para siempre.
      clearTimeout(temporizador);
      temporizador = setTimeout(() => {
        etiqueta.textContent = etiqueta.dataset.etiqueta ?? '';
        aviso.textContent = '';
      }, MS_AVISO);
    },
    // El portapapeles existía pero rechazó la escritura: se hace lo que el
    // enlace prometía, abrir el cliente de correo.
    alFallar: (enlace) => {
      window.location.href = (enlace as HTMLAnchorElement).href;
    },
  });
</script>
