---
import CopyEmail from './CopyEmail.tsx';
import CvButton from './CvButton.astro';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const email = 'maluganijuanmanuel@gmail.com';

const textos: Record<Lang, { titulo: string; bajada: string }> = {
  es: {
    titulo: 'Contacto',
    bajada: 'Estoy buscando mi primer puesto full-time en QA. Escribime y respondo dentro de las 24 horas.',
  },
  en: {
    titulo: 'Contact',
    bajada: "I'm looking for my first full-time QA role. Write to me and I'll get back to you within 24 hours.",
  },
};
const c = textos[lang];
---
<div data-testid="contacto">
  <h1 class="text-3xl font-bold sm:text-4xl">{c.titulo}</h1>
  <p class="mt-3 max-w-prose text-muted">{c.bajada}</p>

  <div class="mt-8">
    <CopyEmail
      email={email}
      textoCopiar={t('contacto.copiar')}
      textoCopiado={t('contacto.copiado')}
      client:load
    />
  </div>

  <ul class="mt-6 flex gap-4">
    <li>
      <a href="https://www.linkedin.com/in/maluganijuanmanuel" data-testid="link-linkedin"
        class="text-accent hover:underline">LinkedIn</a>
    </li>
    <li>
      <a href="https://github.com/Malu-gani" data-testid="link-github"
        class="text-accent hover:underline">GitHub</a>
    </li>
  </ul>

  <div class="mt-8"><CvButton lang={lang} /></div>
</div>
