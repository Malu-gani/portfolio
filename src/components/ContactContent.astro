---
import CopyEmail from './CopyEmail.tsx';
import CvButton from './CvButton.astro';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props { lang: Lang; nivelTitulo?: 1 | 2 }
const { lang, nivelTitulo = 1 } = Astro.props;
const TituloTag = nivelTitulo === 1 ? 'h1' : 'h2';
const t = useTranslations(lang);
const email = 'maluganijuanmanuel@gmail.com';

const textos: Record<Lang, { titulo: string; bajada: string }> = {
  es: {
    titulo: 'Contacto',
    bajada: 'Estoy buscando mi primer puesto full-time en QA. Escribime y respondo dentro de las 24 horas.',
  },
  en: {
    titulo: 'Contact',
    bajada: "I'm looking for my first full-time QA role. Write to me and I'll get back to you within 24 hours.",
  },
};
const c = textos[lang];
---
<div data-testid="contacto">
  <!--
    Embebido en la home el encabezado va centrado, como el del resto de las
    secciones; en `/es/contacto`, que es su propia página, sigue alineado a la
    izquierda. Es la misma condicionalidad que `ProyectoListadoFiltrable`, y por
    el mismo motivo: el ritmo de sección aplica a la home, no a las páginas.
  -->
  <TituloTag class:list={
    nivelTitulo === 1
      ? 'text-3xl font-bold sm:text-4xl'
      : 'text-center text-2xl font-semibold'
  }>{c.titulo}</TituloTag>
  <p class:list={['mt-3 max-w-prose text-muted', nivelTitulo === 2 && 'mx-auto text-center']}>{c.bajada}</p>

  <div class="mt-8">
    <CopyEmail
      email={email}
      textoCopiar={t('contacto.copiar')}
      textoCopiado={t('contacto.copiado')}
      textoError={t('contacto.errorCopiar')}
      client:load
    />
  </div>

  <ul class="mt-6 flex gap-4">
    <li>
      <a href="https://www.linkedin.com/in/juanmanuelmalugani" data-testid="link-linkedin"
        class="text-accent hover:underline" target="_blank" rel="noopener noreferrer">LinkedIn</a>
    </li>
    <li>
      <a href="https://github.com/Malu-gani" data-testid="link-github"
        class="text-accent hover:underline" target="_blank" rel="noopener noreferrer">GitHub</a>
    </li>
  </ul>

  <div class="mt-8"><CvButton lang={lang} /></div>
</div>
