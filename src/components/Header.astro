---
import ThemeToggle from './ThemeToggle.tsx';
import LangToggle from './LangToggle.astro';
import BottomNav from './BottomNav.astro';
import IconoBug from './IconoBug.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

const lang: Lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// El navbar es contextual: en la home los items son anclas y el scroll-spy
// marca la sección visible; en cualquier otra página son enlaces a la home
// posicionada en esa sección.
const home = `/${lang}/`;
const enHome = Astro.url.pathname === home || Astro.url.pathname === `/${lang}`;

const secciones = [
  { id: 'inicio', testid: 'nav-inicio', texto: t('nav.inicio') },
  { id: 'sobre-mi', testid: 'nav-sobre', texto: t('nav.sobre') },
  { id: 'proyectos', testid: 'nav-proyectos', texto: t('nav.proyectos') },
  { id: 'stack', testid: 'nav-stack', texto: t('nav.stack') },
  { id: 'formacion', testid: 'nav-formacion', texto: t('nav.formacion') },
  { id: 'contacto', testid: 'nav-contacto', texto: t('nav.contacto') },
];
---
<header class="sticky top-0 z-50 border-b border-border bg-bg/95 backdrop-blur">
  <nav data-testid="nav-principal" aria-label={t('nav.principal')}
    class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-4">
    <ul data-testid="nav-secciones" class="hidden flex-wrap gap-4 sm:flex">
      {secciones.map((s) => (
        <li>
          <a href={enHome ? `#${s.id}` : `${home}#${s.id}`}
            data-testid={s.testid} data-seccion={s.id}
            class="text-muted transition-colors hover:text-accent focus-visible:text-accent aria-[current=true]:text-accent">
            {s.texto}
          </a>
        </li>
      ))}
    </ul>
    <div class="flex items-center gap-2">
      <!--
        El acceso a reportar no entra en la lista de secciones: entra acá, en
        el grupo de herramientas. Así deja de ser hermano de "Proyectos" -con
        el que no debe competir- y pasa a leerse como lo que es, una acción y
        no un destino del recorrido. De paso no ensancha la fila de secciones,
        que es la que se aprieta en pantallas medianas.

        Lleva `data-seccion` y el del panel mobile no: el scroll-spy indexa por
        ese atributo en un Map y dos enlaces con el mismo id se pisarían.
      -->
      <a href={enHome ? '#reportar' : `${home}#reportar`}
        data-testid="nav-reportar" data-seccion="reportar"
        aria-label={t('reportar.abrir')} title={t('reportar.abrir')}
        class="flex h-9 w-9 items-center justify-center rounded-md border border-border text-muted transition-colors hover:border-accent hover:text-accent focus-visible:text-accent aria-[current=true]:text-accent">
        <IconoBug />
      </a>
      <LangToggle />
      <ThemeToggle
        etiqueta={t('tema.cambiar')}
        etiquetaClaro={t('tema.claro')}
        etiquetaOscuro={t('tema.oscuro')}
        client:load
      />
    </div>
  </nav>
</header>

<BottomNav enHome={enHome} home={home} secciones={secciones} />

<script>
  // Scroll-spy en vanilla: marcar el enlace de la sección visible. No se hace
  // con un island de React porque el proyecto sostiene que React se usa en
  // exactamente dos, y pagar hidratación para resaltar un enlace no lo
  // justifica.
  let observador: IntersectionObserver | null = null;
  let controlador: AbortController | null = null;

  function activarScrollSpy() {
    // Cada swap del ClientRouter vuelve a llamar acá con un DOM nuevo: sin
    // esto quedarían observadores y listeners del documento anterior.
    observador?.disconnect();
    controlador?.abort();

    const enlaces = document.querySelectorAll<HTMLAnchorElement>('a[data-seccion]');
    if (enlaces.length === 0) return;

    // Un mismo id de sección puede tener más de un link marcándola -desktop y
    // BottomNav repiten los mismos data-seccion-, así que cada id guarda una
    // lista, no un único link.
    const porId = new Map<string, HTMLAnchorElement[]>();
    for (const a of enlaces) {
      const id = a.dataset.seccion;
      if (!id) continue;
      const lista = porId.get(id) ?? [];
      lista.push(a);
      porId.set(id, lista);
    }

    const secciones = [...porId.keys()]
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);

    // Fuera de la home no hay secciones que observar y los enlaces apuntan a
    // otra página: no hay nada que marcar.
    if (secciones.length === 0) return;

    function marcar(id: string) {
      for (const lista of porId.values()) {
        for (const a of lista) a.removeAttribute('aria-current');
      }
      for (const a of porId.get(id) ?? []) a.setAttribute('aria-current', 'true');
    }

    // La última sección nunca alcanza la banda del observador: la página toca
    // el fondo antes. Medido en 1280x800, contacto se queda en 264px con la
    // banda terminando en 240, y el nav marcaba "Stack" estando en contacto.
    const ultima = secciones[secciones.length - 1].id;
    const enElFondo = () =>
      Math.ceil(window.scrollY + window.innerHeight) >= document.documentElement.scrollHeight - 1;

    observador = new IntersectionObserver(
      (entradas) => {
        if (enElFondo()) {
          marcar(ultima);
          return;
        }
        for (const entrada of entradas) {
          if (!entrada.isIntersecting) continue;
          marcar(entrada.target.id);
        }
      },
      // El margen superior descuenta el header sticky; el inferior hace que la
      // sección se considere activa recién cuando ocupa la parte de arriba del
      // viewport, y no apenas asoma desde abajo.
      { rootMargin: '-20% 0px -70% 0px' }
    );

    for (const s of secciones) observador.observe(s);

    // Llegar al fondo scrolleando no siempre mueve una sección a través de la
    // banda, así que el observador puede no volver a disparar. Este listener
    // cubre ese caso.
    controlador = new AbortController();
    window.addEventListener(
      'scroll',
      () => {
        if (enElFondo()) marcar(ultima);
      },
      { passive: true, signal: controlador.signal }
    );
  }

  activarScrollSpy();
  // Las view transitions no recargan la página: sin esto, el scroll-spy deja
  // de funcionar tras la primera navegación con el ClientRouter. Es el mismo
  // problema que ya resuelve el script de tema en BaseLayout.astro.
  document.addEventListener('astro:after-swap', activarScrollSpy);
</script>
