---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

/**
 * Botón flotante, oculto en mobile (<640px): ahí ya está BottomNav.astro
 * para volver a "Inicio" con el pulgar, un botón flotante encima
 * competiría por el mismo rincón de pantalla.
 *
 * El scroll suave no necesita JS propio: `scroll-behavior: smooth` ya está
 * seteado en global.css. El único script acá es mostrar/ocultar según
 * cuánto se scrolleó.
 */
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const home = `/${lang}/`;
const enHome = Astro.url.pathname === home || Astro.url.pathname === `/${lang}`;
---
<a href={enHome ? '#inicio' : `${home}#inicio`} data-testid="volver-arriba"
  aria-label={t('volverArriba.aria')} title={t('volverArriba.aria')}
  class="fixed bottom-6 right-6 z-50 hidden h-10 w-10 items-center justify-center rounded-full border border-border bg-surface text-muted opacity-0 shadow-lg transition-opacity duration-200 hover:border-accent hover:text-accent focus-visible:text-accent sm:flex data-[visible=true]:opacity-100 data-[visible=false]:pointer-events-none">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
    stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true">
    <path d="M12 19V5M5 12l7-7 7 7" />
  </svg>
</a>

<script>
  const UMBRAL = 300;

  function activarVolverArriba() {
    const boton = document.querySelector<HTMLAnchorElement>('[data-testid="volver-arriba"]');
    if (!boton) return;

    function actualizar() {
      boton!.dataset.visible = window.scrollY > UMBRAL ? 'true' : 'false';
    }

    actualizar();
    window.addEventListener('scroll', actualizar, { passive: true });
  }

  activarVolverArriba();
  // Las view transitions no recargan la página: sin esto, el botón queda
  // en el estado (visible u oculto) que tenía justo antes de navegar.
  document.addEventListener('astro:after-swap', activarVolverArriba);
</script>
